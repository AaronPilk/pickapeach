{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Pages project (advanced mode: out/_worker.js handles /api/*, /go/*, /m/*).
  "name": "pickapeach",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SUPABASE_URL": "https://qcuzrmceswanetrmimzn.supabase.co"
  },
  // Creator photo + video uploads.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "pickapeach-media" }]
  // Secrets (Pages → Settings → Variables and secrets, type "Secret"):
  //   SUPABASE_KEY       Supabase secret key (sb_secret_...). Until it's set the Worker uses the public key built into
  //                      worker/index.ts. See README → Security.
  //   LEAD_WEBHOOK_URL   GoHighLevel / Zapier webhook that gets every new lead and every opt-out
  //   ALERT_WEBHOOK_URL  webhook pinged when a takedown or privacy request arrives (urgent ones flagged)
}
