{
  "name": "pickapeach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/pull-approved.mjs && next dev",
    "sync:sheet": "node scripts/sync-sheet.mjs",
    "placeholders": "node scripts/make-placeholders.mjs",
    "build": "node scripts/pull-approved.mjs && node scripts/check-data.mjs && next build && node scripts/pages-worker.mjs",
    "preview": "npm run build && wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.157.0"
  }
}
